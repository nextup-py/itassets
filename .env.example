APP_NAME=ITAssets
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# 'daily' rotates and prunes old log files on its own (LOG_DAILY_DAYS below) —
# use 'single' only for local debugging, never unattended in production
# (a single laravel.log grows forever and nobody is around to trim it).
# 'sentry_logs' (see SENTRY_* below) is a no-op until SENTRY_LARAVEL_DSN is set,
# so it's safe to leave in the stack even before Sentry is configured.
LOG_STACK=daily,sentry_logs
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Where unattended backup alerts (success/failure, low disk, stale backup) are sent.
# Defaults to ADMIN_EMAIL below when left blank.
BACKUP_NOTIFICATION_EMAIL=

# Sentry (error tracking). Get a DSN at sentry.io → new project → platform "Laravel".
# Leave blank to disable entirely (every Sentry feature below is a safe no-op without it).
SENTRY_LARAVEL_DSN=
# Fraction of requests to trace for performance/slow-query visibility (0.0–1.0).
# 0.2 (20%) is enough to spot patterns without paying to trace every request.
SENTRY_TRACES_SAMPLE_RATE=0.2
# Also send warning+ log entries (not just exceptions) to Sentry as structured logs.
SENTRY_ENABLE_LOGS=true
SENTRY_LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=itassets
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Mail is configurable from the panel itself (Sistema > Correo, Admin-only) —
# what's set there overrides these at runtime. These .env values are only the
# fallback used until someone configures a provider in the panel.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
# Used when MAIL_MAILER=resend
RESEND_KEY=
MAIL_FROM_ADDRESS="noreply@itassets.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Credenciales del usuario administrador inicial (usado en el seeder)
ADMIN_NAME="Admin"
ADMIN_EMAIL=admin@itassets.test
ADMIN_PASSWORD=password
